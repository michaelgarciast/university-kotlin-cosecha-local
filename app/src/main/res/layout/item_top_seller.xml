<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.CosechaLocal.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/spacing_tiny">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/icon_button_min_size"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_medium">

        <TextView
            android:id="@+id/tvRank"
            android:layout_width="@dimen/rank_badge_size"
            android:layout_height="@dimen/rank_badge_size"
            android:background="@drawable/bg_stat_icon"
            android:contentDescription="@string/cd_rank"
            android:gravity="center"
            android:textColor="@color/primary_green"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold"
            tools:text="1" />

        <TextView
            android:id="@+id/tvSellerName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_medium"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_subtitle"
            tools:text="Finca El Cafetal" />

        <TextView
            android:id="@+id/tvSellerAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/primary_green"
            android:textSize="@dimen/text_size_subtitle"
            android:textStyle="bold"
            tools:text="$41,3 M" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
