<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium">

        <!-- Back Header Button -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/icon_button_min_size"
            android:layout_height="@dimen/icon_button_min_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back_button"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/primary_green" />

        <!-- Large Product Image Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CosechaLocal.Card"
            android:layout_width="match_parent"
            android:layout_height="@dimen/product_detail_image_height"
            android:layout_marginTop="@dimen/spacing_small">

            <ImageView
                android:id="@+id/ivProductDetailImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_product_image"
                android:contentDescription="@string/cd_product_image"
                android:padding="@dimen/spacing_large"
                android:scaleType="centerInside"
                android:src="@drawable/ic_product_placeholder" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Product Name & Price Header -->
        <TextView
            android:id="@+id/tvProductName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_header"
            android:textStyle="bold"
            tools:text="Café de origen 500 g" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvProductPrice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/primary_green"
                android:textSize="24sp"
                android:textStyle="bold"
                tools:text="$32.000" />

            <!-- Stock Chip -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chipStock"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/dark_green"
                app:chipBackgroundColor="@color/chip_selected_bg"
                app:chipStrokeColor="@color/primary_green"
                tools:text="Stock: 15 disp." />
        </LinearLayout>

        <!-- Description -->
        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_subtitle"
            tools:text="Café especial suave de origen antioqueño con notas a chocolate, caramelo y frutos rojos. Tostión media artesanal." />

        <!-- Producer Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CosechaLocal.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/producer_card_title"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_caption" />

                <TextView
                    android:id="@+id/tvProducerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_subtitle"
                    android:textStyle="bold"
                    tools:text="Finca El Cafetal" />

                <TextView
                    android:id="@+id/tvProducerDistance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_body"
                    tools:text="A 3.2 km de tu ubicación" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewMap"
                    style="@style/Widget.CosechaLocal.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="@string/btn_view_map"
                    app:icon="@drawable/ic_location" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Quantity Selector Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/quantity_label"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_subtitle"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_quantity_selector"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnDecrease"
                    android:layout_width="@dimen/icon_button_min_size"
                    android:layout_height="@dimen/icon_button_min_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_decrease_quantity"
                    android:src="@drawable/ic_remove"
                    app:tint="@color/primary_green" />

                <TextView
                    android:id="@+id/tvQuantity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="40dp"
                    android:textAlignment="center"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_subtitle"
                    android:textStyle="bold"
                    tools:text="1" />

                <ImageButton
                    android:id="@+id/btnIncrease"
                    android:layout_width="@dimen/icon_button_min_size"
                    android:layout_height="@dimen/icon_button_min_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_increase_quantity"
                    android:src="@drawable/ic_add"
                    app:tint="@color/primary_green" />
            </LinearLayout>
        </LinearLayout>

        <!-- Add to Cart Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddToCart"
            style="@style/Widget.CosechaLocal.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:text="@string/btn_add_to_cart"
            app:icon="@drawable/ic_cart"
            app:iconGravity="textStart"
            app:iconTint="@color/white" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
