<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Primary Button Style -->
    <style name="Widget.CosechaLocal.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary_green</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="cornerRadius">@dimen/corner_radius_button</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_size_subtitle</item>
    </style>

    <!-- Secondary Outlined Button Style -->
    <style name="Widget.CosechaLocal.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/primary_green</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/primary_green</item>
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="cornerRadius">@dimen/corner_radius_button</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_size_subtitle</item>
        <item name="iconTint">@color/primary_green</item>
    </style>

    <!-- Text Button Style -->
    <style name="Widget.CosechaLocal.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/primary_green</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- TextInputLayout Style -->
    <style name="Widget.CosechaLocal.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primary_green</item>
        <item name="hintTextColor">@color/primary_green</item>
        <item name="boxCornerRadiusTopStart">@dimen/corner_radius_medium</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_radius_medium</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_radius_medium</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_radius_medium</item>
        <item name="startIconTint">@color/primary_green</item>
        <item name="endIconTint">@color/primary_green</item>
    </style>

    <!-- Card Style -->
    <style name="Widget.CosechaLocal.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/corner_radius_large</item>
        <item name="cardElevation">3dp</item>
        <item name="cardBackgroundColor">@color/card_surface</item>
        <item name="strokeColor">@color/divider_color</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Typography Styles -->
    <style name="Widget.CosechaLocal.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_size_header</item>
    </style>

    <style name="Widget.CosechaLocal.Subtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_size_subtitle</item>
    </style>

    <!-- Danger Outlined Button Style -->
    <style name="Widget.CosechaLocal.Button.Danger" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/error_red</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/error_red</item>
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="cornerRadius">@dimen/corner_radius_button</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_size_subtitle</item>
        <item name="iconTint">@color/error_red</item>
    </style>


    <!-- Seller: compact text button for card actions (48dp touch target) -->
    <style name="Widget.CosechaLocal.Button.CardAction" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/primary_green</item>
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textStyle">bold</item>
        <item name="iconTint">@color/primary_green</item>
    </style>

    <style name="Widget.CosechaLocal.Button.CardActionDanger" parent="Widget.CosechaLocal.Button.CardAction">
        <item name="android:textColor">@color/error_red</item>
        <item name="iconTint">@color/error_red</item>
    </style>

    <!-- Seller: read-only status/stock chip -->
    <style name="Widget.CosechaLocal.Chip.Status" parent="Widget.Material3.Chip.Assist">
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textSize">@dimen/text_size_caption</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Seller: amber floating action button -->
    <style name="Widget.CosechaLocal.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/amber_accent</item>
        <item name="tint">@color/dark_green</item>
    </style>
</resources>
