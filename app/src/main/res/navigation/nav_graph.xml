<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <!-- Auth Destinations -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.garcia.cosechalocal.ui.auth.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_recoverPasswordFragment"
            app:destination="@id/recoverPasswordFragment" />
        <action
            android:id="@+id/action_loginFragment_to_buyerHome"
            app:destination="@id/navigation_buyer_home"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_loginFragment_to_sellerDashboard"
            app:destination="@id/navigation_seller_dashboard"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_loginFragment_to_adminDashboard"
            app:destination="@id/navigation_admin_dashboard"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.garcia.cosechalocal.ui.auth.RegisterFragment"
        android:label="Registro"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/recoverPasswordFragment"
        android:name="com.garcia.cosechalocal.ui.auth.RecoverPasswordFragment"
        android:label="Recuperar Contraseña"
        tools:layout="@layout/fragment_recover_password">
        <action
            android:id="@+id/action_recoverPasswordFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Buyer Role Destinations -->
    <fragment
        android:id="@+id/navigation_buyer_home"
        android:name="com.garcia.cosechalocal.ui.buyer.HomeFragment"
        android:label="@string/menu_buyer_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_buyer_home_to_productDetail"
            app:destination="@id/productDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/navigation_buyer_search"
        android:name="com.garcia.cosechalocal.ui.buyer.CatalogFragment"
        android:label="@string/menu_buyer_search"
        tools:layout="@layout/fragment_catalog">
        <action
            android:id="@+id/action_buyer_search_to_productDetail"
            app:destination="@id/productDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/navigation_buyer_cart"
        android:name="com.garcia.cosechalocal.ui.buyer.CartFragment"
        android:label="@string/menu_buyer_cart"
        tools:layout="@layout/fragment_cart">
        <action
            android:id="@+id/action_buyer_cart_to_checkout"
            app:destination="@id/checkoutFragment" />
    </fragment>

    <fragment
        android:id="@+id/navigation_buyer_orders"
        android:name="com.garcia.cosechalocal.ui.common.PlaceholderFragment"
        android:label="@string/menu_buyer_orders"
        tools:layout="@layout/fragment_placeholder" />

    <fragment
        android:id="@+id/navigation_buyer_profile"
        android:name="com.garcia.cosechalocal.ui.buyer.ProfileFragment"
        android:label="@string/menu_buyer_profile"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/productDetailFragment"
        android:name="com.garcia.cosechalocal.ui.buyer.ProductDetailFragment"
        android:label="@string/product_detail_title"
        tools:layout="@layout/fragment_product_detail">
        <argument
            android:name="productId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/checkoutFragment"
        android:name="com.garcia.cosechalocal.ui.buyer.CheckoutFragment"
        android:label="@string/checkout_title"
        tools:layout="@layout/fragment_checkout" />

    <!-- Seller Role Destinations -->
    <fragment
        android:id="@+id/navigation_seller_dashboard"
        android:name="com.garcia.cosechalocal.ui.seller.SellerDashboardFragment"
        android:label="@string/menu_seller_dashboard"
        tools:layout="@layout/fragment_seller_dashboard" />

    <fragment
        android:id="@+id/navigation_seller_products"
        android:name="com.garcia.cosechalocal.ui.seller.SellerProductsFragment"
        android:label="@string/menu_seller_products"
        tools:layout="@layout/fragment_seller_products" />

    <fragment
        android:id="@+id/navigation_seller_orders"
        android:name="com.garcia.cosechalocal.ui.seller.SellerOrdersFragment"
        android:label="@string/menu_seller_orders"
        tools:layout="@layout/fragment_seller_orders" />

    <fragment
        android:id="@+id/navigation_seller_store"
        android:name="com.garcia.cosechalocal.ui.seller.SellerProfileFragment"
        android:label="@string/menu_seller_store"
        tools:layout="@layout/fragment_seller_profile" />

    <fragment
        android:id="@+id/productFormFragment"
        android:name="com.garcia.cosechalocal.ui.seller.ProductFormFragment"
        android:label="@string/form_title_new"
        tools:layout="@layout/fragment_product_form">
        <argument
            android:name="productId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <!-- Admin Role Destinations -->
    <fragment
        android:id="@+id/navigation_admin_dashboard"
        android:name="com.garcia.cosechalocal.ui.common.PlaceholderFragment"
        android:label="@string/menu_admin_dashboard"
        tools:layout="@layout/fragment_placeholder" />

    <fragment
        android:id="@+id/navigation_admin_users"
        android:name="com.garcia.cosechalocal.ui.common.PlaceholderFragment"
        android:label="@string/menu_admin_users"
        tools:layout="@layout/fragment_placeholder" />

    <fragment
        android:id="@+id/navigation_admin_products"
        android:name="com.garcia.cosechalocal.ui.common.PlaceholderFragment"
        android:label="@string/menu_admin_products"
        tools:layout="@layout/fragment_placeholder" />

    <fragment
        android:id="@+id/navigation_admin_payments"
        android:name="com.garcia.cosechalocal.ui.common.PlaceholderFragment"
        android:label="@string/menu_admin_payments"
        tools:layout="@layout/fragment_placeholder" />

    <fragment
        android:id="@+id/navigation_admin_settings"
        android:name="com.garcia.cosechalocal.ui.common.PlaceholderFragment"
        android:label="@string/menu_admin_settings"
        tools:layout="@layout/fragment_placeholder" />

</navigation>
